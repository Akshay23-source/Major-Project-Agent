# Secrets for the marketplace integration Edge Functions.
# Production:  supabase secrets set --env-file supabase/functions/.env
# Local:       supabase functions serve --env-file supabase/functions/.env
# NEVER put these in the app's .env / EXPO_PUBLIC_* variables.

# Farm Marketplace backend base URL (no trailing slash), e.g. https://api.your-marketplace.com
MARKETPLACE_API_URL=
# Shared secret. Must equal AGRI_AGENT_API_KEY in the Farm Marketplace backend/.env
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPLACE_API_KEY=
# agents.id that receives marketplace orders (SELECT id, name FROM agents;)
MARKETPLACE_DEFAULT_AGENT_ID=

# Optional
MARKETPLACE_CALLBACK_PATH=/api/integration/order-status
MARKETPLACE_TIMEOUT_MS=10000
