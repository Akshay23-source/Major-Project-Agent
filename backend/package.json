{
  "name": "agri-agent-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Agri Agent logistics API (Express + MongoDB Atlas)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
