# Agri Agent backend — copy to backend/.env and fill in. NEVER commit backend/.env.

# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (use * during local development)
CORS_ORIGINS=*

# ── MongoDB Atlas (the Farm Marketplace database) ───────
# Agri Agent only reads/writes collections prefixed agri_* in this database.
MONGODB_URI=

# ── Auth ────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── Farm Marketplace integration ────────────────────────
# Shared secret in BOTH directions. Must equal AGRI_AGENT_API_KEY in the
# Farm Marketplace backend/.env.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPLACE_API_KEY=
# Email of the Agri Agent account that receives marketplace orders
# (sign up in the app first, then put that email here).
MARKETPLACE_DEFAULT_AGENT_EMAIL=
# Farm Marketplace backend base URL for status callbacks, e.g. http://192.168.1.20:5000
MARKETPLACE_API_URL=
MARKETPLACE_CALLBACK_PATH=/api/integration/order-status
MARKETPLACE_TIMEOUT_MS=10000

# ── Callback worker ─────────────────────────────────────
SYNC_WORKER_ENABLED=true
SYNC_WORKER_INTERVAL_MS=15000

# ── AI assistant (optional) ─────────────────────────────
OPENAI_API_KEY=
SARVAM_API_KEY=
