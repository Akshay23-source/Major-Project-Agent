# Agri Agent app. Anything prefixed EXPO_PUBLIC_ is bundled into the app — never put secrets here.
# URL of the Agri Agent backend (backend/), reachable from the phone running Expo Go.
# Use your computer's LAN IP (e.g. http://192.168.1.10:4000), not localhost.
EXPO_PUBLIC_API_URL=

# All server secrets (MongoDB, JWT, Marketplace key, AI keys) live in backend/.env.
